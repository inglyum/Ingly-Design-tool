# ==============================================
# INGLY OS — Environment Variables
# Copia questo file in .env e compila i valori
# ==============================================

# DATABASE
DATABASE_URL="postgresql://ingly:inglypass@localhost:5432/inglydb"

# REDIS
REDIS_URL="redis://localhost:6379"

# JWT
JWT_SECRET="cambia-questo-segreto-con-qualcosa-di-lungo-e-casuale-min-32chars"
JWT_EXPIRY="15m"
REFRESH_TOKEN_EXPIRY="30d"

# ADMIN API
ADMIN_API_URL="http://localhost:4000"
ADMIN_PORT=4000

# FRONTEND
NEXT_PUBLIC_API_URL="http://localhost:4000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXTAUTH_SECRET="cambia-questo-segreto-nextauth"
NEXTAUTH_URL="http://localhost:3000"

# STRIPE (opzionale per dev)
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."

# AI (opzionale)
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""

# EMAIL (opzionale)
RESEND_API_KEY=""
EMAIL_FROM="noreply@ingly.app"

# STORAGE (opzionale, default MinIO locale)
S3_ENDPOINT="http://localhost:9000"
S3_BUCKET="ingly-dev"
S3_ACCESS_KEY="minioadmin"
S3_SECRET_KEY="minioadmin"
S3_REGION="eu-west-1"
